---
import SEOHead from "@/components/SEOHead.astro";
import { sanityClient } from "@/lib/sanity";
import { siteSettingsQuery } from "@/lib/queries";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const settings = await sanityClient.fetch(siteSettingsQuery);
const {
  title = settings?.defaultMetaTitle || "Estate Agent Demo",
  description = settings?.defaultMetaDescription,
  ogImage = settings?.ogImage?.asset?.url,
  jsonLd,
  noindex,
} = Astro.props;

const siteName = settings?.siteName || "Estate Agent Demo";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      title={fullTitle}
      description={description}
      ogImage={ogImage}
      jsonLd={jsonLd}
      noindex={noindex}
    />
    {settings?.favicon?.asset?.url && (
      <link rel="icon" type="image/png" href={settings.favicon.asset.url} />
    )}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    {settings?.googleAnalyticsId && (
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${settings.googleAnalyticsId}`}
      />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Top utility bar -->
    <div class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <a href="/contact">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" /></svg>
            List your property
          </a>
        </div>
        <div class="topbar-right">
          {settings?.phone && (
            <a href={`tel:${settings.phone}`}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              {settings.phone}
            </a>
          )}
          {settings?.email && (
            <a href={`mailto:${settings.email}`}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              {settings.email}
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Header -->
    <header class="site-header">
      <div class="container flex items-center justify-between">
        <a href="/" class="wordmark flex items-center gap-2">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10" /></svg>
          {siteName}
        </a>

        <nav class="site-nav hidden md:flex">
          <a href="/about" class="nav-link">About</a>
          <a href="/properties" class="nav-link">Properties</a>
          <a href="/map" class="nav-link">Map Search</a>
          <a href="/areas" class="nav-link">Areas</a>
          <a href="/team" class="nav-link">Our Team</a>
          <a href="/contact" class="nav-link">Contact</a>
          <a href="/valuation" class="btn btn-primary nav-cta">Book Valuation</a>
        </nav>

        <button
          class="md:hidden p-2 text-white"
          aria-label="Open menu"
          onclick="document.getElementById('mobile-menu')?.classList.toggle('hidden')"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden md:hidden site-mobile-menu">
        <nav>
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/properties">Properties</a>
          <a href="/map">Map Search</a>
          <a href="/areas">Areas</a>
          <a href="/team">Our Team</a>
          <a href="/contact">Contact</a>
          <a href="/valuation" class="btn btn-primary" style="margin: 12px 20px;">Book Valuation</a>
        </nav>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer mt-auto">
      <div class="container py-12 md:py-16">
        <div class="site-footer-grid">
          <!-- Discover -->
          <div>
            <h4>Discover</h4>
            <ul>
              <li><span class="footer-link"><a href="/areas/sampletown-north">Sampletown North</a></span></li>
              <li><span class="footer-link"><a href="/areas/sampletown-south">Sampletown South</a></span></li>
              <li><span class="footer-link"><a href="/areas/sampletown-west">Sampletown West</a></span></li>
              <li><span class="footer-link"><a href="/areas/sampletown-east">Sampletown East</a></span></li>
              <li><span class="footer-link"><a href="/areas">View all areas</a></span></li>
            </ul>
          </div>

          <!-- Explore -->
          <div>
            <h4>Explore</h4>
            <ul>
              <li><span class="footer-link"><a href="/properties?status=for-sale">For Sale</a></span></li>
              <li><span class="footer-link"><a href="/properties?status=for-rent">To Let</a></span></li>
              <li><span class="footer-link"><a href="/map">Map Search</a></span></li>
              <li><span class="footer-link"><a href="/team">Our Team</a></span></li>
              <li><span class="footer-link"><a href="/valuation">Book a Valuation</a></span></li>
            </ul>
          </div>

          <!-- Buy or Rent -->
          <div>
            <h4>Buy or Rent</h4>
            <ul>
              <li><span class="footer-link"><a href="/properties?status=for-sale">Properties for Sale</a></span></li>
              <li><span class="footer-link"><a href="/properties?status=for-rent">Properties to Let</a></span></li>
              <li><span class="footer-link"><a href="/valuation">Free Valuation</a></span></li>
              <li><span class="footer-link"><a href="/contact">Get in Touch</a></span></li>
            </ul>
          </div>

          <!-- Contact Us -->
          <div>
            <h4>Contact Us</h4>
            {settings?.phone && (
              <div class="site-footer-contact-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                <a href={`tel:${settings.phone}`}>{settings.phone}</a>
              </div>
            )}
            {settings?.email && (
              <div class="site-footer-contact-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                <a href={`mailto:${settings.email}`}>{settings.email}</a>
              </div>
            )}
            <div class="site-footer-contact-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3M12 22a10 10 0 100-20 10 10 0 000 20z" /></svg>
              <span>Mon–Sat, 9am–6pm</span>
            </div>
          </div>
        </div>

        {settings?.socialLinks?.length > 0 && (
          <div class="footer-socials">
            {settings.socialLinks.map((link: { platform: string; url: string }) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.platform}
              </a>
            ))}
          </div>
        )}
      </div>
      <div class="footer-bottom">
        <div class="container">
          <div class="wordmark">{siteName}</div>
          {settings?.footerText || `© ${new Date().getFullYear()} ${siteName}. All rights reserved.`}
        </div>
      </div>
    </footer>

    <!-- Scroll to top -->
    <button
      id="scroll-top"
      class="scroll-top"
      aria-label="Scroll to top"
      onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <script is:inline>
      // Toggle scroll-to-top visibility
      const scrollBtn = document.getElementById("scroll-top");
      if (scrollBtn) {
        const onScroll = () => {
          if (window.scrollY > 400) scrollBtn.classList.add("is-visible");
          else scrollBtn.classList.remove("is-visible");
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
