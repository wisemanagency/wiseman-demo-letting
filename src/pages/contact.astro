---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm";
import PageHero from "@/components/PageHero.astro";
import { sanityClient } from "@/lib/sanity";
import { siteSettingsQuery } from "@/lib/queries";

const settings = await sanityClient.fetch(siteSettingsQuery);
---

<Base title="Contact Us" description="Get in touch with our team. We're here to help with your property search.">
  <PageHero title="Contact Us" ariaLabel="Contact us" />

  <div class="container" style="padding-top: 32px;">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Contact" },
      ]}
    />

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div>
        <p style="color: var(--color-text-secondary); margin-bottom: 32px; font-size: 15px;">
          Whether you're looking to buy, sell, rent, or let — our team is ready to help.
        </p>

        <div class="space-y-6 mb-10">
          {settings?.phone && (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(30, 187, 238, 0.12);">
                <svg class="w-5 h-5" style="color: var(--color-brand-cyan);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-meta" style="font-size: 12px; color: var(--color-text-muted); margin-bottom: 4px;">Phone</p>
                <a href={`tel:${settings.phone}`} style="color: var(--color-text-primary); font-weight: 500;">{settings.phone}</a>
              </div>
            </div>
          )}

          {settings?.email && (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(30, 187, 238, 0.12);">
                <svg class="w-5 h-5" style="color: var(--color-brand-cyan);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-meta" style="font-size: 12px; color: var(--color-text-muted); margin-bottom: 4px;">Email</p>
                <a href={`mailto:${settings.email}`} style="color: var(--color-text-primary); font-weight: 500;">{settings.email}</a>
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="card card-body">
        <h2 class="text-section-heading" style="text-align: left; font-size: 20px; margin-bottom: 24px;">Send Us a Message</h2>
        <ContactForm client:visible />
      </div>
    </div>
  </div>
</Base>
