---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm";
import PageHero from "@/components/PageHero.astro";
---

<Base title="Book a Free Valuation" description="Get a free, no-obligation property valuation from our local experts.">
  <PageHero title="Free Property Valuation" ariaLabel="Free property valuation" />

  <div class="container" style="padding-top: 32px;">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Free Valuation" },
      ]}
    />

    <p class="max-w-3xl mx-auto text-center" style="color: var(--color-text-secondary); font-size: 17px; margin-bottom: 32px;">
      Book a free, no-obligation valuation. Our local experts will visit your property and give you an honest, market-led appraisal.
    </p>

    <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
      <!-- Benefits -->
      <div>
        <h2 class="text-section-heading" style="text-align: left; font-size: 22px; margin-bottom: 24px;">Why Choose Us?</h2>
        <div class="space-y-5">
          {[
            { title: "Local Market Expertise", desc: "We know your area inside out — from pricing trends to buyer demand." },
            { title: "No Obligation", desc: "Our valuations are completely free. There's no pressure to list with us." },
            { title: "Accurate & Honest", desc: "We give realistic figures based on comparable sales, not inflated promises." },
            { title: "Quick Turnaround", desc: "Book today, get your valuation within 48 hours." },
          ].map((item) => (
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(139, 195, 74, 0.18);">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-status-featured);">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <p style="font-weight: 600; font-size: 15px; margin-bottom: 4px;">{item.title}</p>
                <p style="font-size: 14px; color: var(--color-text-secondary);">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Form -->
      <div class="card card-body">
        <h2 class="text-section-heading" style="text-align: left; font-size: 20px; margin-bottom: 24px;">Request Your Free Valuation</h2>
        <ContactForm client:visible />
      </div>
    </div>
  </div>
</Base>
