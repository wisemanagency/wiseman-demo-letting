---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EpcBadge from "@/components/EpcBadge.astro";
import ImageGallery from "@/components/ImageGallery";
import MapEmbed from "@/components/MapEmbed";
import VideoPlayer from "@/components/VideoPlayer";
import FloorplansViewer from "@/components/FloorplansViewer";
import ContactForm from "@/components/ContactForm";
import AgentCard from "@/components/AgentCard.astro";
import SimilarListings from "@/components/SimilarListings";
import MortgageCalculator from "@/components/MortgageCalculator";
import { sanityClient } from "@/lib/sanity";
import { propertyBySlugQuery, allPropertiesQuery } from "@/lib/queries";
import { formatPrice, formatRent, furnishedLabel, statusLabel, statusColour, fullAddress, propertySummary } from "@/lib/utils";
import { PortableText } from "@portabletext/react";

// Generate static paths at build time
export async function getStaticPaths() {
  const properties = await sanityClient.fetch(allPropertiesQuery);
  return properties.map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const [property, allProperties] = await Promise.all([
  sanityClient.fetch(propertyBySlugQuery, { slug }),
  sanityClient.fetch(allPropertiesQuery),
]);

if (!property) {
  return Astro.redirect("/404");
}

const address = fullAddress(property);
const summary = propertySummary(property);
const isLetting =
  property.status === "for-rent" ||
  property.status === "let-agreed" ||
  property.status === "let";
const primaryPrice = isLetting
  ? formatRent(property.rentPerMonth, property.rentPeriod)
  : formatPrice(property.price, property.priceQualifier);
const ogImage = property.images?.[0]?.asset?.url
  ? `${property.images[0].asset.url}?w=1200&h=630&fit=crop&auto=format`
  : undefined;

// JSON-LD for RealEstateListing
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "RealEstateListing",
  name: property.title,
  description: property.metaDescription || `${summary} in ${property.town}`,
  url: Astro.url.href,
  ...(ogImage && { image: ogImage }),
  offers: {
    "@type": "Offer",
    price: property.price,
    priceCurrency: "GBP",
    availability: property.status === "sold" || property.status === "let"
      ? "https://schema.org/SoldOut"
      : "https://schema.org/InStock",
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: [property.addressLine1, property.addressLine2].filter(Boolean).join(", "),
    addressLocality: property.town,
    addressRegion: property.county,
    postalCode: property.postcode,
    addressCountry: "GB",
  },
  ...(property.location && {
    geo: {
      "@type": "GeoCoordinates",
      latitude: property.location.lat,
      longitude: property.location.lng,
    },
  }),
  numberOfRooms: (property.bedrooms || 0) + (property.receptionRooms || 0),
  numberOfBedrooms: property.bedrooms,
  numberOfBathroomsTotal: property.bathrooms,
  ...(property.sqft && {
    floorSize: {
      "@type": "QuantitativeValue",
      value: property.sqft,
      unitCode: "FTK",
    },
  }),
};
---

<Base
  title={property.metaTitle || `${property.title} | ${primaryPrice}`}
  description={property.metaDescription || `${summary}. ${address}`}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="container" style="padding-top: 32px;">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Properties", href: "/properties" },
        { label: property.title },
      ]}
    />

    <!-- Gallery -->
    {property.images?.length > 0 && (
      <div class="mb-8" style="margin-top: 24px;">
        <ImageGallery client:load images={property.images} title={property.title} />
      </div>
    )}

    <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <!-- Header -->
        <div class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class:list={["badge", statusColour(property.status)]}>
              {statusLabel(property.status)}
            </span>
            {property.epc && <EpcBadge rating={property.epc} size="sm" />}
          </div>

          <h1 class="text-section-heading" style="text-align: left; font-size: 32px; margin-bottom: 8px;">{property.title}</h1>
          <p style="color: var(--color-text-muted); margin-bottom: 16px;">{address}</p>

          <p class="text-price-lg" style="font-size: 24px;">
            {primaryPrice}
          </p>
        </div>

        <!-- Key stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          {property.bedrooms != null && (
            <div class="card text-center" style="padding: 16px;">
              <p class="text-section-heading" style="font-size: 24px; margin-bottom: 4px;">{property.bedrooms}</p>
              <p class="text-meta" style="font-size: 12px; color: var(--color-text-muted);">Bedrooms</p>
            </div>
          )}
          {property.bathrooms != null && (
            <div class="card text-center" style="padding: 16px;">
              <p class="text-section-heading" style="font-size: 24px; margin-bottom: 4px;">{property.bathrooms}</p>
              <p class="text-meta" style="font-size: 12px; color: var(--color-text-muted);">Bathrooms</p>
            </div>
          )}
          {property.receptionRooms != null && (
            <div class="card text-center" style="padding: 16px;">
              <p class="text-section-heading" style="font-size: 24px; margin-bottom: 4px;">{property.receptionRooms}</p>
              <p class="text-meta" style="font-size: 12px; color: var(--color-text-muted);">Receptions</p>
            </div>
          )}
          {property.sqft != null && (
            <div class="card text-center" style="padding: 16px;">
              <p class="text-section-heading" style="font-size: 24px; margin-bottom: 4px;">{property.sqft.toLocaleString("en-GB")}</p>
              <p class="text-meta" style="font-size: 12px; color: var(--color-text-muted);">Sq Ft</p>
            </div>
          )}
        </div>

        <!-- Key Features -->
        {property.features?.length > 0 && (
          <div class="mb-8">
            <h2 class="text-section-heading" style="text-align: left; font-size: 22px; margin-bottom: 16px;">Key Features</h2>
            <ul class="grid md:grid-cols-2 gap-2">
              {property.features.map((feature: string) => (
                <li class="flex items-start gap-2 text-sm" style="color: var(--color-text-secondary);">
                  <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-status-featured);">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Description -->
        {property.description && (
          <div class="mb-8">
            <h2 class="text-section-heading" style="text-align: left; font-size: 22px; margin-bottom: 16px;">Full Description</h2>
            <div class="prose prose-gray max-w-none text-sm leading-relaxed">
              <PortableText value={property.description} />
            </div>
          </div>
        )}

        <!-- Details table -->
        <div class="mb-8">
          <h2 class="text-section-heading" style="text-align: left; font-size: 22px; margin-bottom: 16px;">Property Details</h2>
          <div class="card" style="overflow: hidden;">
            <table class="w-full text-sm">
              <tbody>
                {property.propertyType && (
                  <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                    <td class="py-3 px-4 font-medium w-1/3" style="color: var(--color-text-secondary);">Type</td>
                    <td class="py-3 px-4">{property.propertyType}</td>
                  </tr>
                )}
                {property.tenure && (
                  <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                    <td class="py-3 px-4 font-medium" style="color: var(--color-text-secondary);">Tenure</td>
                    <td class="py-3 px-4">{property.tenure}</td>
                  </tr>
                )}
                {property.councilTaxBand && (
                  <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                    <td class="py-3 px-4 font-medium" style="color: var(--color-text-secondary);">Council Tax</td>
                    <td class="py-3 px-4">Band {property.councilTaxBand}</td>
                  </tr>
                )}
                {property.epc && (
                  <tr>
                    <td class="py-3 px-4 font-medium" style="color: var(--color-text-secondary);">EPC Rating</td>
                    <td class="py-3 px-4"><EpcBadge rating={property.epc} size="sm" /></td>
                  </tr>
                )}
                {isLetting && property.furnished && (
                  <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                    <td class="py-3 px-4 font-medium" style="color: var(--color-text-secondary);">Furnished</td>
                    <td class="py-3 px-4">{furnishedLabel(property.furnished)}</td>
                  </tr>
                )}
                {isLetting && property.minTermMonths != null && (
                  <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                    <td class="py-3 px-4 font-medium" style="color: var(--color-text-secondary);">Minimum Term</td>
                    <td class="py-3 px-4">{property.minTermMonths} months</td>
                  </tr>
                )}
                {isLetting && property.availableFrom && (
                  <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                    <td class="py-3 px-4 font-medium" style="color: var(--color-text-secondary);">Available From</td>
                    <td class="py-3 px-4">{new Date(property.availableFrom).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</td>
                  </tr>
                )}
                {isLetting && property.depositAmount != null && (
                  <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                    <td class="py-3 px-4 font-medium" style="color: var(--color-text-secondary);">Deposit</td>
                    <td class="py-3 px-4">£{property.depositAmount.toLocaleString("en-GB")}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Floorplans (with placeholder fallback until clients upload their own) -->
        <div class="mb-8">
          <h2 class="text-section-heading" style="text-align: left; font-size: 22px; margin-bottom: 16px;">Floorplans</h2>
          <FloorplansViewer
            client:visible
            floorplans={property.floorplans?.length
              ? property.floorplans
              : [{ label: "Sample floor plan", image: { asset: { url: "/floorplan-placeholder.svg" } } }]}
          />
          {!property.floorplans?.length && (
            <p class="text-meta" style="margin-top: 8px; font-size: 12px; color: var(--color-text-muted);">
              Sample floor plan — clients can upload their own from the Floorplans field in Sanity Studio.
            </p>
          )}
        </div>

        <!-- Virtual Tour (with placeholder until a URL is set) -->
        <div class="mb-8">
          <h2 class="text-section-heading" style="text-align: left; font-size: 22px; margin-bottom: 16px;">Virtual Tour</h2>
          {property.virtualTourUrl ? (
            <div class="aspect-video rounded-md overflow-hidden" style="border: 1px solid var(--color-border-subtle);">
              <iframe
                src={property.virtualTourUrl}
                class="w-full h-full"
                allowfullscreen
                loading="lazy"
              />
            </div>
          ) : (
            <div
              class="aspect-video rounded-md flex flex-col items-center justify-center gap-3"
              style="border: 1px dashed var(--color-border-subtle); background: var(--color-surface-alt); color: var(--color-text-muted);"
            >
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <p style="font-size: 14px; font-weight: 500;">Virtual tour coming soon</p>
            </div>
          )}
          {!property.virtualTourUrl && (
            <p class="text-meta" style="margin-top: 8px; font-size: 12px; color: var(--color-text-muted);">
              Clients can paste a Matterport, iGuide or YouTube link into the Virtual Tour URL field in Sanity Studio.
            </p>
          )}
        </div>

        <!-- Video Tour -->
        {property.videos?.length > 0 && (
          <div class="mb-8">
            <h2 class="text-section-heading" style="text-align: left; font-size: 22px; margin-bottom: 16px;">Video Tour</h2>
            <VideoPlayer client:visible videos={property.videos} />
          </div>
        )}

        <!-- Map -->
        {property.location && (
          <div class="mb-8">
            <h2 class="text-section-heading" style="text-align: left; font-size: 22px; margin-bottom: 16px;">Location</h2>
            <MapEmbed
              client:visible
              lat={property.location.lat}
              lng={property.location.lng}
              title={property.title}
            />
          </div>
        )}

        <!-- Similar Listings -->
        <SimilarListings
          client:load
          property={{ _id: property._id, town: property.town, propertyType: property.propertyType }}
          allProperties={allProperties}
        />
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="sticky top-28 space-y-4">
          <!-- Enquiry Form -->
          <div class="card card-body">
            <h3 class="text-section-heading" style="text-align: left; font-size: 18px; margin-bottom: 16px;">Enquire About This Property</h3>
            <ContactForm
              client:visible
              propertyTitle={property.title}
              branchEmail={property.branch?.email}
            />
          </div>

          {property.agent && (
            <div>
              <p class="text-meta" style="margin-bottom: 8px; color: var(--color-text-muted);">Your agent</p>
              <AgentCard
                agent={property.agent}
                variant="compact"
                showWhatsApp={true}
                propertyTitle={property.title}
              />
            </div>
          )}

          <!-- Mortgage Calculator -->
          <MortgageCalculator
            client:visible
            propertyPrice={property.price}
          />

          {property.branch && (
            <div class="card card-body" style="text-align: center;">
              <p class="text-section-heading" style="text-align: center; font-size: 17px; margin-bottom: 12px;">{property.branch.name}</p>
              {property.branch.phone && (
                <a href={`tel:${property.branch.phone}`} class="flex items-center justify-center gap-2 text-sm" style="color: var(--color-text-secondary); margin-bottom: 4px;">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                  <span>{property.branch.phone}</span>
                </a>
              )}
              {property.branch.email && (
                <a href={`mailto:${property.branch.email}`} class="flex items-center justify-center gap-2 text-sm" style="color: var(--color-text-secondary);">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                  <span>{property.branch.email}</span>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</Base>
