---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import PropertyGrid from "@/components/PropertyGrid.astro";
import { sanityClient } from "@/lib/sanity";
import { featuredPropertiesQuery, siteSettingsQuery, allAreasQuery } from "@/lib/queries";

const settings = await sanityClient.fetch(siteSettingsQuery);
const properties = await sanityClient.fetch(featuredPropertiesQuery);
const areas = await sanityClient.fetch(allAreasQuery);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: settings?.siteName,
  url: Astro.url.origin,
  telephone: settings?.phone,
  email: settings?.email,
};
---

<Base jsonLd={jsonLd}>
  <Hero siteName={settings?.siteName || "Estate Agent"} tagline={settings?.siteTagline} />

  <!-- Featured Properties -->
  <section class="section">
    <div class="container">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-section-heading" style="text-align: left; font-size: 28px; font-weight: 600; line-height: 1.3;">Latest Properties</h2>
          <p class="text-meta" style="margin-top: 8px; color: var(--color-text-muted); font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em;">Freshly listed homes ready for viewing</p>
        </div>
        <a
          href="/properties"
          class="hidden md:inline-flex chevron-link"
        >
          View all
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <PropertyGrid properties={properties} />

      <div class="mt-8 text-center md:hidden">
        <a href="/properties" class="btn btn-primary">View All Properties</a>
      </div>
    </div>
  </section>

  <!-- Areas We Cover -->
  {areas?.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <h2>Areas We Cover</h2>
          <p>Local expertise across the communities we serve</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {areas.map((area: any) => (
            <a
              href={`/areas/${area.slug}`}
              class="group relative aspect-[4/3] rounded-md overflow-hidden bg-gray-200"
            >
              {area.heroImage?.asset?.url && (
                <img
                  src={`${area.heroImage.asset.url}?w=400&h=300&fit=crop&auto=format`}
                  alt={area.name}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
                  loading="lazy"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent" />
              <div class="absolute bottom-0 left-0 p-4">
                <h3 style="color: #fff; font-size: 17px; font-weight: 500;">{area.name}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA: Valuation -->
  <section class="section">
    <div class="container" style="text-align: center;">
      <div class="section-heading">
        <h2>Thinking of Selling?</h2>
        <p>Honest appraisal from our local experts — free, no obligation</p>
      </div>
      <p style="max-width: 560px; margin: 0 auto 32px; color: var(--color-text-secondary); font-size: 15px;">
        Get a free, no-obligation valuation from our local experts. We'll give you an honest appraisal of your property's worth.
      </p>
      <a href="/valuation" class="btn btn-primary" style="padding: 14px 32px;">Book a Free Valuation</a>
    </div>
  </section>
</Base>
