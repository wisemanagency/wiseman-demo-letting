---
import Base from "@/layouts/Base.astro";
---

<Base title="Page Not Found" noindex={true}>
  <div class="section text-center">
    <div class="container">
      <p style="font-size: 96px; font-weight: 700; color: var(--color-border-subtle); line-height: 1; margin-bottom: 16px;">404</p>
      <h1 class="text-section-heading" style="font-size: 28px; margin-bottom: 12px;">Page Not Found</h1>
      <p style="color: var(--color-text-secondary); margin-bottom: 32px;">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex justify-center gap-3 flex-wrap">
        <a href="/" class="btn btn-primary">Go Home</a>
        <a href="/properties" class="btn btn-outline" style="color: var(--color-brand-navy); border-color: var(--color-border-subtle);">Browse Properties</a>
      </div>
    </div>
  </div>
</Base>
