---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHero from "@/components/PageHero.astro";
import { sanityClient } from "@/lib/sanity";
import { allAreasQuery } from "@/lib/queries";

const areas = await sanityClient.fetch(allAreasQuery);
---

<Base title="Areas We Cover" description="Explore the areas where we help people buy, sell, and rent homes.">
  <PageHero title="Areas We Cover" ariaLabel="Areas we cover" />

  <div class="container" style="padding-top: 32px;">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Areas" },
      ]}
    />

    <p style="color: var(--color-text-secondary); font-size: 15px; margin-bottom: 32px;">
      Browse properties by area. Each neighbourhood page includes local insights, transport links, and all available listings.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {areas.map((area: any) => (
        <a
          href={`/areas/${area.slug}`}
          class="group relative aspect-[4/3] rounded-md overflow-hidden bg-gray-200 card"
          style="box-shadow: 0 2px 8px rgba(15,23,42,0.06);"
        >
          {area.heroImage?.asset?.url && (
            <img
              src={`${area.heroImage.asset.url}?w=600&h=450&fit=crop&auto=format`}
              alt={area.name}
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
              loading="lazy"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
          <div class="absolute bottom-0 left-0 p-5">
            <h2 style="color: #fff; font-size: 18px; font-weight: 600; margin-bottom: 4px;">{area.name}</h2>
            <span style="color: rgba(255,255,255,0.7); font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em;">
              View properties →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
