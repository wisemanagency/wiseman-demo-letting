---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AgentCard from "@/components/AgentCard.astro";
import { sanityClient } from "@/lib/sanity";
import { allAgentsQuery, siteSettingsQuery } from "@/lib/queries";

const agents = await sanityClient.fetch(allAgentsQuery);
const settings = await sanityClient.fetch(siteSettingsQuery);
const siteName = settings?.siteName || "Our Agency";
---

<Base
  title={`Our Team | ${siteName}`}
  description={`Meet the team at ${siteName}. Experienced estate agents ready to help you buy, sell, or rent your next home.`}
>
  <div class="container py-8 md:py-12">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Our Team" },
      ]}
    />

    <div class="max-w-2xl mb-10">
      <h1 class="text-section-heading" style="text-align: left; font-size: 32px; margin-bottom: 16px;">Meet Our Team</h1>
      <p style="color: var(--color-text-secondary); font-size: 17px;">
        Our experienced agents know the local market inside out. Whether you're buying, selling, or letting, we're here to guide you every step of the way.
      </p>
    </div>

    {agents?.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {agents.map((agent: any) => (
          <AgentCard agent={agent} variant="full" />
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p style="color: var(--color-text-muted); font-size: 17px;">Team members coming soon.</p>
      </div>
    )}
  </div>

  <!-- CTA -->
  <section class="section section-alt">
    <div class="container text-center">
      <div class="section-heading">
        <h2>Want to Join Our Team?</h2>
        <p>We're always looking for talented agents</p>
      </div>
      <p style="max-width: 560px; margin: 0 auto 24px; color: var(--color-text-secondary); font-size: 15px;">
        We're always looking for talented agents who share our passion for property.
      </p>
      <a href="/contact" class="btn btn-primary">Get in Touch</a>
    </div>
  </section>
</Base>
