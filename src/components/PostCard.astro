---
interface Author {
  name: string;
  slug?: string;
  photo?: { asset?: { url?: string } };
}

interface Props {
  post: {
    title: string;
    slug: string;
    excerpt: string;
    publishedAt: string;
    readTime?: number;
    coverImage: {
      asset?: { url?: string; metadata?: { lqip?: string } };
      alt?: string;
    };
    author?: Author;
  };
}

const { post } = Astro.props;

const imageUrl = post.coverImage?.asset?.url
  ? `${post.coverImage.asset.url}?w=600&h=450&fit=crop&auto=format`
  : "/estate-office-outdoor.webp";
const lqip = post.coverImage?.asset?.metadata?.lqip;

const formattedDate = new Date(post.publishedAt).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<a href={`/blog/${post.slug}`} class="card block group">
  <div class="property-image relative">
    <img
      src={imageUrl}
      alt={post.coverImage?.alt || post.title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
      style={lqip ? `background-image: url(${lqip}); background-size: cover;` : ""}
    />
  </div>

  <div class="card-body">
    <p class="text-meta mb-2" style="font-size: 12px; color: var(--color-text-muted);">
      <time datetime={post.publishedAt}>{formattedDate}</time>
      {post.readTime && (
        <>
          <span style="margin: 0 6px;">·</span>
          <span>{post.readTime} min read</span>
        </>
      )}
    </p>

    <h3
      class="text-card-title text-text-primary mb-2"
      style="line-clamp: 2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
    >
      {post.title}
    </h3>

    <p
      class="text-sm"
      style="color: var(--color-text-secondary); line-clamp: 3; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"
    >
      {post.excerpt}
    </p>

    {post.author?.name && (
      <p
        class="text-meta mt-3 pt-3"
        style="font-size: 12px; color: var(--color-text-muted); border-top: 1px solid var(--color-border-subtle);"
      >
        By {post.author.name}
      </p>
    )}
  </div>
</a>