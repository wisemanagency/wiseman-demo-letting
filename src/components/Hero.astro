---

interface Props {
  tagline?: string;
  /** Background image URL for the hero. Falls back to a navy gradient. */
  backgroundImage?: string;
}

const { tagline, backgroundImage } = Astro.props;

const heroBg = backgroundImage
  ? `url('${backgroundImage}')`
  : "linear-gradient(135deg, var(--color-brand-navy) 0%, var(--color-brand-navy-dark) 100%)";
---

<section class="hero" aria-label="Homepage hero">
  <div class="hero-bg" style={`background-image: ${heroBg};`}></div>

  <div class="container hero-inner">
    <h1>{tagline || "Find your next place to rent"}</h1>

    <!-- Search bar centred in the middle of the hero (replaces the
         previous pill row + overhanging search-bar combo) -->
    <form action="/properties" method="get" class="search-bar hero-search-bar">
      <input
        type="text"
        name="q"
        class="sb-cell"
        placeholder="Enter location, postcode or keyword…"
        style="background-image: none; text-align: left;"
      />
      <select name="bedrooms" class="sb-cell" aria-label="Bedrooms">
        <option value="">Any Beds</option>
        <option value="1">1+</option>
        <option value="2">2+</option>
        <option value="3">3+</option>
        <option value="4">4+</option>
      </select>
      <select name="bathrooms" class="sb-cell" aria-label="Bathrooms">
        <option value="">Any Baths</option>
        <option value="1">1+</option>
        <option value="2">2+</option>
        <option value="3">3+</option>
      </select>
      <select name="maxRent" class="sb-cell" aria-label="Max rent">
        <option value="">Max Rent</option>
        <option value="800">Up to £800 pcm</option>
        <option value="1200">Up to £1,200 pcm</option>
        <option value="1500">Up to £1,500 pcm</option>
        <option value="2000">Up to £2,000 pcm</option>
        <option value="3000">Up to £3,000 pcm</option>
      </select>
      <button type="submit" class="sb-submit">Search</button>
    </form>
  </div>
</section>
