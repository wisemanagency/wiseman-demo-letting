---
interface Props {
  siteName: string;
  tagline?: string;
}

const { siteName, tagline } = Astro.props;
---

<section class="relative overflow-hidden text-white" style="background: linear-gradient(135deg, var(--color-brand-navy) 0%, var(--color-brand-navy-dark) 100%);">
  <!-- Decorative shapes -->
  <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 -translate-y-1/2 translate-x-1/3" style="background: var(--color-brand-cyan);"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full opacity-10 translate-y-1/2 -translate-x-1/4" style="background: var(--color-brand-cyan);"></div>

  <div class="container relative z-10 py-20 md:py-28 text-center">
    <h1 class="text-page-hero mb-3" style="color: #fff;">
      {tagline || `Find Your Perfect Home`}
    </h1>
    <p class="text-base md:text-lg max-w-2xl mx-auto mb-8" style="color: rgba(255,255,255,0.75); font-weight: 400;">
      Browse our curated selection of properties. Expert guidance from {siteName}.
    </p>

    <!-- Quick search bar -->
    <form action="/properties" method="get" class="max-w-3xl mx-auto">
      <div class="flex flex-col sm:flex-row bg-white rounded-md overflow-hidden" style="box-shadow: 0 8px 24px rgba(0,0,0,0.18);">
        <input
          type="text"
          name="q"
          placeholder="Search by location, postcode, or keyword..."
          class="flex-1 px-5 py-4 text-base outline-none placeholder:text-gray-400"
          style="color: var(--color-text-primary); font-family: var(--font-sans);"
        />
        <button
          type="submit"
          class="btn btn-primary"
          style="border-radius: 0; padding: 16px 32px;"
        >
          Search
        </button>
      </div>
    </form>

    <!-- Quick links -->
    <div class="flex flex-wrap justify-center gap-4 mt-6">
      <a href="/properties?status=for-sale" class="text-meta" style="color: rgba(255,255,255,0.7); text-decoration: underline; text-underline-offset: 4px;">
        For Sale
      </a>
      <a href="/properties?status=for-rent" class="text-meta" style="color: rgba(255,255,255,0.7); text-decoration: underline; text-underline-offset: 4px;">
        To Let
      </a>
      <a href="/valuation" class="text-meta" style="color: rgba(255,255,255,0.7); text-decoration: underline; text-underline-offset: 4px;">
        Free Valuation
      </a>
    </div>
  </div>
</section>
