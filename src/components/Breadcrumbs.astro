---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.url.origin).href } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-meta mb-6" style="color: var(--color-text-muted); font-size: 13px;">
  <ol class="flex items-center gap-2 flex-wrap">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span style="color: var(--color-border-subtle);">/</span>}
        {item.href ? (
          <a
            href={item.href}
            class="chevron-link"
            style="text-transform: none; font-size: 13px; letter-spacing: 0;"
          >
            {item.label}
          </a>
        ) : (
          <span style="color: var(--color-text-primary); font-weight: 500;">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
