---
/**
 * ListingsCTA — 2-column section: image left, heading + copy + red CTA right.
 * Designed to sit directly under the Hero. Matches the existing typography
 * (Poppins display, navy/orange palette) and reuses .btn-primary for the CTA.
 */
---
<section class="listings-cta" aria-label="Listings">
  <div class="container listings-cta-grid">
    <!-- Left: photo -->
    <div class="listings-cta-image">
      <img
        src="/home-image-1.webp"
        alt="Estate agent discussing listings with clients at a desk"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Right: copy + red CTA -->
    <div class="listings-cta-copy">
      <h2>Listings like no other letting agent offers</h2>
      <p>
        Whether you're letting, renting or just curious about your home's worth,
        our team combines local expertise with honest advice and modern marketing
        to get your property seen by the right tenants.
      </p>
      <p>
        Professional photography, floorplans, virtual tours and listings across
        all the major portals — included as standard.
      </p>
      <a href="/valuation" class="btn btn-primary">Get Started</a>
    </div>
  </div>
</section>