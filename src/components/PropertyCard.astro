---
import { formatPrice, formatRent, furnishedLabel, statusLabel } from "@/lib/utils";

interface Props {
  property: {
    slug: string;
    title: string;
    status: string;
    propertyType?: string;
    price: number;
    priceQualifier?: string;
    rentPerMonth?: number;
    rentPeriod?: string;
    furnished?: string;
    bedrooms?: number;
    bathrooms?: number;
    sqft?: number;
    town?: string;
    postcode?: string;
    featured?: boolean;
    thumbnail?: {
      asset: { url: string; metadata?: { lqip?: string } };
      alt?: string;
    };
  };
}

const { property } = Astro.props;
const {
  slug,
  title,
  status,
  price,
  priceQualifier,
  rentPerMonth,
  rentPeriod,
  furnished,
  bedrooms,
  bathrooms,
  sqft,
  town,
  postcode,
  featured,
  thumbnail,
} = property;

const imageUrl = thumbnail?.asset?.url
  ? `${thumbnail.asset.url}?w=600&h=450&fit=crop&auto=format`
  : "/floorplan-placeholder.svg";
const lqip = thumbnail?.asset?.metadata?.lqip;

const isLetting =
  status === "for-rent" || status === "let-agreed" || status === "let";
const statusClass =
  status === "for-sale" || status === "sold-stc" || status === "under-offer"
    ? "badge-sale"
    : isLetting
      ? "badge-rent"
      : "badge-muted";
---

<a
  href={`/properties/${slug}`}
  class="card property-card block"
>
  <div class="property-image relative">
    <img
      src={imageUrl}
      alt={thumbnail?.alt || title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
      style={lqip ? `background-image: url(${lqip}); background-size: cover;` : ""}
    />
    <span class:list={["badge absolute top-3 left-3", statusClass]}>
      {statusLabel(status)}
    </span>
    {featured && (
      <span class="badge badge-featured absolute top-3 right-3">Featured</span>
    )}
  </div>

  <div class="card-body">
    <p class="text-price-lg mb-1.5">
      {isLetting && rentPerMonth != null
        ? formatRent(rentPerMonth, rentPeriod)
        : formatPrice(price, priceQualifier)}
    </p>

    <h3 class="text-card-title text-text-primary mb-1.5 line-clamp-1">
      {title}
    </h3>

    {(town || postcode) && (
      <p class="text-meta mb-3" style="font-size: 12px; color: var(--color-text-muted);">
        {[town, postcode].filter(Boolean).join(", ")}
      </p>
    )}

    <div class="flex items-center gap-4 text-meta border-t pt-3" style="font-size: 12px; color: var(--color-text-muted); border-color: var(--color-border-subtle);">
      {isLetting && furnished && (
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
          </svg>
          {furnishedLabel(furnished)}
        </span>
      )}
      {bedrooms != null && (
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4" />
          </svg>
          {bedrooms} bed
        </span>
      )}
      {bathrooms != null && (
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M4 16h16M4 16V8a4 4 0 014-4h1" />
          </svg>
          {bathrooms} bath
        </span>
      )}
      {sqft != null && (
        <span>{sqft.toLocaleString("en-GB")} sq ft</span>
      )}
    </div>
  </div>
</a>
