---
/**
 * BookEvalBar — full-width navy band with a single cyan CTA, sitting
 * directly under the ListingsCTA section. Mirrors the red "Book Evaluation"
 * bar in the reference, restyled in the Estate Agent brand colours.
 */
---
<section class="book-eval-bar" aria-label="Book an evaluation">
  <div class="container book-eval-bar-inner">
    <div class="book-eval-bar-copy">
      <h2>Book a Free Evaluation</h2>
      <p>Honest, no-obligation appraisal from our local experts — usually within 48 hours.</p>
    </div>
    <a href="/valuation" class="btn btn-primary book-eval-bar-cta">
      Book Evaluation
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</section>